# Copy this file to .env and fill in real values for local development.

# --- Django ---
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- MongoDB ---
# Local: mongodb://localhost:27017/verseid
# Atlas: mongodb+srv://<user>:<password>@<cluster-url>/verseid?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/verseid

# Connection pool tuning (see config/settings.py's connect() call for the
# full explanation). Safe to leave unset — these are the defaults already.
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6379
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=30

# --- JWT ---
# If unset, falls back to DJANGO_SECRET_KEY. Use a separate, dedicated
# secret in production.
JWT_SECRET=change-this-to-a-different-long-random-string
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# --- Google OAuth ---
# From Google Cloud Console > APIs & Services > Credentials.
# Must match the client ID configured in the frontend's .env
# (VITE_GOOGLE_CLIENT_ID / equivalent) — Google ID tokens are issued for a
# specific client ID and this backend verifies that audience claim.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Supabase Storage (avatar storage) ---
# REQUIRED in production — Django doesn't serve local-disk uploads when
# DEBUG=False, so without this every avatar upload will 404. Create a
# project at supabase.com, then Storage → create a bucket (e.g. "avatars")
# and mark it PUBLIC in the bucket's settings. SUPABASE_SERVICE_ROLE_KEY is
# under Settings → API → service_role — a secret admin key, treat it like a
# password. Leave unset for local dev (falls back to local disk automatically).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars

# --- Gemini + Groq (interface language) ---
# LLM-based translation instead of a dedicated translation API — chosen
# because bible/languages.py lists mostly Nigerian/African indigenous
# languages (Yoruba, Igbo, Hausa, Nigerian Pidgin, etc.) that dedicated
# translation APIs tend to cover poorly. Gemini is tried first; Groq is the
# fallback if Gemini is unset or fails. Both optional — leave unset for
# English-only UI.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Paystack (Nigerian payment processor for Pro subscriptions) ---
# From https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Auth cookies (refresh token) ---
# Both are commented out by default so the smart fallback in
# config/settings.py applies: COOKIE_SECURE auto-follows DJANGO_DEBUG (off
# locally, on in prod) and COOKIE_DOMAIN defaults to a host-only cookie,
# which is correct for local dev. Uncomment and set explicitly in
# production:
#   COOKIE_DOMAIN=.verseid.top   (leading dot, the PARENT domain — not
#                                 api.verseid.top itself — so the cookie
#                                 set by the API host is still attached to
#                                 requests aimed at it from the frontend)
#   COOKIE_SECURE=True           (both verseid.top and api.verseid.top are
#                                 HTTPS-only in production; belt-and-
#                                 suspenders since DJANGO_DEBUG=False
#                                 already implies this by default)
COOKIE_DOMAIN=.verseid.top
COOKIE_SECURE=True

# --- Frontend URL ---
# Base URL of the deployed frontend — used to build links/asset URLs inside
# transactional emails (welcome email, password reset code, logo image).
FRONTEND_URL=http://localhost:3000

# --- Hugging Face Inference API (semantic search re-rank) ---
# Free token from https://huggingface.co/settings/tokens. Optional — if
# unset, verse identification runs lexical-matching-only (see
# search/matching.py); semantic re-rank just silently doesn't fire.
HF_API_TOKEN=

# --- Admin dashboard ---
# Any long random string — the shared secret required to view
# /admin-dashboard/. Treat it like a password; don't commit a real value.
ADMIN_API_KEY=
REDIS_URL=